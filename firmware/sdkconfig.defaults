# Watcher input-assistant PoC — Phase 0
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM on the Watcher
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# v0.4.3 (R2): allow EXT_RAM_BSS_ATTR to place .bss in PSRAM (seal crypto
# scratch buffers moved out of internal DRAM).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Needed by {"t":"dbg","cmd":"tasks"} (uxTaskGetSystemState)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_SPIRAM_SIZE_8MB=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144

# Console stays on UART0 (the USB-UART bridge). The JSON host link shares this
# port: log lines and JSON lines are interleaved on TX, and the host agent
# ignores any line that is not valid JSON. This keeps idf.py monitor usable
# during bring-up. (A later phase can move the link to a dedicated channel.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# BLE HID via NimBLE; bonds persist in NVS so re-pairing isn't needed
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_BUF_DEFAULT=5744

# ESP-SR wake-word (v0.3.4): "Hi, ESP" (wn9_hiesp) as the working interim
# model. "Hey Muse" / "Hey Watcher" need Espressif custom training
# (see wakeword/DESIGN.md); the AFE supports 2 models, so they drop in
# via wakenet_model_name_2 when available.
CONFIG_SR_WN_WN9_HIESP=y

# LVGL 8 for the SPD2010 status screen (RGB565 panel on QSPI)
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# PTT mic codec (esp_codec_dev) must use the legacy I2C driver, not driver_ng.
# The rest of the firmware (eyes/I2C0, touch, wheel/PCA9535) uses the old
# driver/i2c.h API; mixing driver_ng on the same I2C port causes
# "CONFLICT! driver_ng is not allowed to be used with this old driver" abort.
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=y

# v0.3.9 RAM: WiFi is used occasionally (legacy HTTP snapshot POST, wifi cmd).
# Reduce static RX buffers 10->6 (saves 6.4KB internal). Dynamic buffers (32)
# handle bursts. Do not reduce further without measuring WiFi stability.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# v0.4.6: KEEP CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y.
# John's architecture: watchdogs stay ACTIVE; we feed them from main's loop.
# If main hangs, the RTC WDT SHOULD fire (reset reason 7).
# (Removing this was tried and was WRONG: ESP-IDF's startup then disables
# the RTC WDT via init_disable_rtc_wdt, the opposite of the goal.)
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y

# v0.4.5: task WDT must PANIC (print stack trace) instead of resetting
# silently. The spontaneous reboot loop produces no panic/assert logs;
# we need the task name + backtrace to root-cause it.
CONFIG_ESP_TASK_WDT_PANIC=y
